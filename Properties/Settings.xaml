<Window x:Class="AssetRegistryModMigrator.Windows.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AssetRegistryModMigrator.Windows" xmlns:local1="clr-namespace:AssetRegistryModMigrator.Model"
        mc:Ignorable="d"      Name="SettingsWindow"
        Title="ARMM Settings"
        Height="560" Width="820" MinWidth="700" MinHeight="460"
        Background="#1E1E1E" Foreground="#E0E0E0"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Dark TreeViewItem Style -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="IsExpanded" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0E639C"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 1. Boolean Setting Card -->
        <DataTemplate x:Key="BooleanSettingTemplate">
            <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#999999" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding BoolValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          VerticalAlignment="Center" Cursor="Hand">
                        <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                                <Border x:Name="Box" Width="22" Height="22" CornerRadius="4"
                    Background="#141414" BorderBrush="#555558" BorderThickness="1.5">
                                    <TextBlock x:Name="CheckMark" Text="✔" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Box" Property="Background" Value="#0E639C"/>
                                        <Setter TargetName="Box" Property="BorderBrush" Value="#3794FF"/>
                                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Box" Property="BorderBrush" Value="#3794FF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </CheckBox.Template>
                    </CheckBox>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 2. File / Folder Path Setting Card -->
        <DataTemplate x:Key="PathSettingTemplate">
            <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#999999" TextWrapping="Wrap" Margin="0,3,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding StringValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#141414" Foreground="#9CDCFE" BorderBrush="#3E3E42"
                                 FontFamily="Consolas" FontSize="12" Padding="8,6" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Browse…" Click="BrowsePath_Click" Tag="{Binding}"
                                Background="#333337" Foreground="#E0E0E0" BorderBrush="#4E4E52"
                                Padding="12,6" Margin="8,0,0,0" Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 3. String Setting Card -->
        <DataTemplate x:Key="StringSettingTemplate">
            <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#999999" TextWrapping="Wrap" Margin="0,3,0,8"/>
                    <TextBox Text="{Binding StringValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Background="#141414" Foreground="#E0E0E0" BorderBrush="#3E3E42"
                             FontFamily="Consolas" FontSize="12" Padding="8,6"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <local:JsonSettingTemplateSelector x:Key="SettingCardSelector"
            BooleanTemplate="{StaticResource BooleanSettingTemplate}"
            PathTemplate="{StaticResource PathSettingTemplate}"
            StringTemplate="{StaticResource StringSettingTemplate}"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- MAIN SPLIT WORKSPACE -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: CATEGORY SIDEBAR -->
            <Border Grid.Column="0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CATEGORIES" FontSize="10" FontWeight="Bold" Foreground="#888888" Margin="4,2,0,8"/>

                    <TextBox DockPanel.Dock="Top" x:Name="CategorySearchBox" TextChanged="CategorySearchBox_TextChanged"
                             Background="#141414" Foreground="#E0E0E0" BorderBrush="#3E3E42"
                             Padding="7,5" Margin="0,0,0,8" ToolTip="Filter settings by name or description"/>

                    <TreeView x:Name="SettingsTree" ItemsSource="{Binding Categories}"
                              SelectedItemChanged="SettingsTree_SelectedItemChanged"
                              Background="Transparent" BorderThickness="0">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding SubCategories}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- RIGHT: SETTINGS CARDS PANEL -->
            <Border Grid.Column="2" Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="{Binding ActiveCategoryTitle}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="{Binding ActiveCategorySubtitle}" FontSize="12" Foreground="#888888" Margin="0,2,0,0"/>
                        <Separator Background="#3E3E42" Margin="0,10,0,0"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding VisibleSettings}" ItemTemplateSelector="{StaticResource SettingCardSelector}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- FOOTER BAR -->
        <Border Grid.Row="1" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📂 Open JSON Folder" Click="OpenSettingsFolder_Click"
                            Background="#333337" Foreground="#CCCCCC" BorderBrush="#4E4E52"
                            Padding="10,5" Cursor="Hand" ToolTip="{Binding SettingsFilePath}"/>
                    <TextBlock Text="Stored in %AppData%\AssetRegistryModMigrator\settings.json"
                               Foreground="#777777" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Reset Defaults" Click="ResetDefaults_Click"
                            Background="Transparent" Foreground="#CCCCCC" BorderBrush="#4E4E52"
                            Padding="12,6" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="Cancel" Click="Cancel_Click"
                            Background="#333337" Foreground="#E0E0E0" BorderBrush="#4E4E52"
                            Padding="14,6" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="💾 Save Settings" Click="Save_Click"
                            Background="#0E639C" Foreground="#FFFFFF" BorderThickness="0"
                            FontWeight="Bold" Padding="16,6" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
