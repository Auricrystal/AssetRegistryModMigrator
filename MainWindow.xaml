<Window x:Class="AssetRegistryModMigrator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AssetRegistryModMigrator"
        xmlns:Model="clr-namespace:AssetRegistryModMigrator.Model" 
        mc:Ignorable="d"
        Title="ARMM" Height="450" Width="800" Loaded="Window_Loaded">
    <Window.Resources>
       
           
                <Style TargetType="TreeViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            

        <HierarchicalDataTemplate DataType="{x:Type Model:FolderNode}" ItemsSource="{Binding Children}" >
            <StackPanel Orientation="Horizontal">
                <!--<CheckBox x:Name="DirectoryCheckmark" Click="CheckBox_Click" IsChecked="{Binding Selected,UpdateSourceTrigger=PropertyChanged}"  IsThreeState="True"/>-->
                <TextBlock Text="{Binding Path=Name}"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type Model:FileNode}">
            <StackPanel Orientation="Horizontal">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="View" Click="View_OnClick"/>
                        <MenuItem Header="Edit" Click="Edit_OnClick"/>
                        <MenuItem Header="Delete" Click="Delete_OnClick"/>
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <CheckBox x:Name="FileCheckmark" Click="CheckBox_Click" IsChecked="{Binding Selected,UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding Path=Name}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open" Click="FileOpen_Click"/>
                <MenuItem Header="_Save" Click="SaveList_Click"/>
            </MenuItem>
            <TextBlock Text="Hello" HorizontalAlignment="Right" Margin="0,0,0,0"/>
        </Menu>
        <Grid Background="LightGray">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="35*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="65*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="90*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TreeView Grid.Column="0" MinWidth="200" x:Name="AssetList" Grid.Row="0" SelectedItemChanged="AssetList_SelectionChanged" TreeViewItem.Selected="TreeViewItem_Selected" TreeViewItem.Expanded="AssetList_Expanded" DataContextChanged="AssetList_DataContextChanged">
                <TreeView.ItemContainerStyle>
                    <!-- This style hooks up the UI state to your data model state -->
                    <Style x:Name="TreeNodeRegistry" TargetType="{x:Type TreeViewItem}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Top"/>
                        <!-- <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="false"/>-->

                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
            <TextBox x:Name="SearchBar" MinWidth="200"  Grid.Row="1" Grid.ColumnSpan="2" TextChanged="SearchBar_TextChanged"/>
            <GridSplitter Grid.Column="1" Width="2" Background="Red" ResizeBehavior="PreviousAndNext"/>
            <TextBox FontSize="10" Grid.Column="2" DockPanel.Dock="Right" x:Name="JsonBox" Background="LightGray" IsReadOnly="True"/>
        </Grid>
    </DockPanel>
</Window>
