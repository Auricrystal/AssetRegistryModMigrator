<Window x:Class="AssetRegistryModMigrator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AssetRegistryModMigrator"
        xmlns:Model="clr-namespace:AssetRegistryModMigrator.Model" 
        mc:Ignorable="d"
        Title="ARMM" Height="450" Width="900" MinWidth="900" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TreeViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type Model:FolderNode}" ItemsSource="{Binding Children}" >
            <StackPanel Orientation="Horizontal">
                <!--<CheckBox x:Name="DirectoryCheckmark" Click="CheckBox_Click" IsChecked="{Binding Selected,UpdateSourceTrigger=PropertyChanged}"  IsThreeState="True"/>-->
                <TextBlock Text="{Binding Path=Name}"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type Model:FileNode}">
            <StackPanel Orientation="Horizontal" MouseRightButtonDown="StackPanel_MouseRightButtonDown" DataContext="{Binding }">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="View Json" ToolTip="Open a window with the json data" Click="View_OnClick" DataContext="{Binding }"/>
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <CheckBox Click="CheckBox_Click" IsChecked="{Binding Selected,UpdateSourceTrigger=PropertyChanged}" DataContext="{Binding }" />
                <TextBlock Text="{Binding Path=Name}" ToolTip="{Binding Path=FullPath}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open" Click="DonorRegistryDialog_Click"/>
                <MenuItem Header="_Save" Click="SaveList_Click"/>
                <MenuItem Header="S_aveAs" Click="SaveList_Click"/>
                <MenuItem Header="Se_ttings" Click="Settings_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_JsonToBin" Click="JsonToBin_Click"/>
                <MenuItem Header="_BinToJson" Click="BinToJson_Click"/>
            </MenuItem>
        </Menu>
        <Grid Background="LightGray">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200*" MaxWidth="300" MinWidth="200"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="500*" MinWidth="300"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="200*" MaxWidth="300" MinWidth="200"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="90*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TreeView Grid.Column="0" x:Name="AssetList" Grid.Row="0" HorizontalAlignment="Stretch" SelectedItemChanged="AssetList_SelectionChanged" TreeViewItem.Expanded="AssetList_Expanded">
                <TreeView.ItemContainerStyle>
                    <!-- This style hooks up the UI state to your data model state -->
                    <Style TargetType="{x:Type TreeViewItem}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Top"/>
                        <EventSetter Event="Loaded" Handler="TreeViewItem_Loaded" />
                        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="false"/>
                    </Style>
                </TreeView.ItemContainerStyle>
           
            </TreeView>
            <!--<TextBox x:Name="SearchBar" MinWidth="200"  Grid.Row="1" Grid.ColumnSpan="2" TextChanged="SearchBar_TextChanged"/>-->
            <GridSplitter Grid.Column="1" Width="2" Background="Red" Panel.ZIndex="2" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Center"/>
            <TextBox FontSize="10" Grid.Column="2" DockPanel.Dock="Right" x:Name="JsonBox" Background="LightGray" IsReadOnly="True" Panel.ZIndex="-1" HorizontalAlignment="Stretch"/>
            <GridSplitter Grid.Column="3" Width="2" Background="Red" Panel.ZIndex="2" ResizeDirection="Columns"  HorizontalAlignment="Center" ResizeBehavior="PreviousAndNext"/>
            <TreeView x:Name="ReceiverAssetList" Grid.Row="0" Grid.Column="4" Panel.ZIndex="1" HorizontalAlignment="Stretch">
                <!--<TreeView.ItemContainerStyle>
                    -->
                <!-- This style hooks up the UI state to your data model state -->
                <!--
                    <Style x:Name="TreeNodeRegistry" TargetType="{x:Type TreeViewItem}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Top"/>
                        -->
                <!-- <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="false"/>-->
                <!--

                    </Style>
                </TreeView.ItemContainerStyle>-->
            </TreeView>
        </Grid>
    </DockPanel>
</Window>
