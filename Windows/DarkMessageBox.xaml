<Window x:Class="AssetRegistryModMigrator.Windows.DarkMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AssetRegistryModMigrator.Windows"
        mc:Ignorable="d"
        Title="Notice"
        SizeToContent="WidthAndHeight"
        MinWidth="380" MaxWidth="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#E0E0E0">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Message Body -->
        <Grid Grid.Row="0" Margin="20,20,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Status Icon Badge -->
            <Border x:Name="IconBadge" Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                    Background="#0E639C" VerticalAlignment="Top" Margin="0,0,14,0">
                <TextBlock x:Name="IconGlyph" Text="ℹ" Foreground="#FFFFFF" FontSize="17" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Message Text -->
            <TextBlock x:Name="MessageText" Grid.Column="1" TextWrapping="Wrap"
                       Foreground="#E0E0E0" FontSize="13" LineHeight="19" VerticalAlignment="Center"/>
        </Grid>

        <!-- Button Footer -->
        <Border Grid.Row="1" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,1,0,0" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="YesButton" Content="Yes" Click="Yes_Click" Visibility="Collapsed"
                        MinWidth="78" Padding="14,6" Margin="0,0,8,0"
                        Background="#0E639C" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>

                <Button x:Name="NoButton" Content="No" Click="No_Click" Visibility="Collapsed"
                        MinWidth="78" Padding="14,6" Margin="0,0,8,0"
                        Background="#333337" Foreground="#E0E0E0" BorderBrush="#4E4E52" BorderThickness="1" Cursor="Hand"/>

                <Button x:Name="OkButton" Content="OK" Click="Ok_Click" Visibility="Collapsed"
                        MinWidth="78" Padding="14,6" Margin="0,0,8,0"
                        Background="#0E639C" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>

                <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed"
                        MinWidth="78" Padding="14,6"
                        Background="#333337" Foreground="#E0E0E0" BorderBrush="#4E4E52" BorderThickness="1" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>