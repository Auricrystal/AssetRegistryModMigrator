<Window x:Class="AssetRegistryModMigrator.Windows.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AssetRegistryModMigrator.Windows" xmlns:local1="clr-namespace:AssetRegistryModMigrator.Model"
        mc:Ignorable="d" Name="SettingsWindow"
        Title="Settings" SizeToContent="WidthAndHeight" MinWidth="550" MinHeight="400" DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Window.Resources>
        <!-- 1. Folder Template -->
        <HierarchicalDataTemplate x:Key="FolderTemplate" ItemsSource="{Binding Children}">
            <Grid  Margin="2">
                <TextBlock Text="📁 " VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>
        </HierarchicalDataTemplate>

        <!-- 2. Boolean Template (Uses a CheckBox) -->
        <DataTemplate x:Key="BooleanTemplate">
            <Grid Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="NameColumn"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ValueColumn"/>
                    <!-- Button gets its own separate column next to the TextBox -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" Width="120" VerticalAlignment="Center"/>
                <CheckBox Grid.Column="1" IsChecked="{Binding Value, Mode=TwoWay}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- 3. String/Text Template (Uses a TextBox) -->
        <DataTemplate x:Key="FilePathTemplate">
            <Grid Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="NameColumn"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ValueColumn"/>
                    <!-- Button gets its own separate column next to the TextBox -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <TextBox Grid.Column="1" MinWidth="180" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="…" Command="{Binding BrowseFileCommand}"  Width="30" Margin="5,0,0,0" VerticalAlignment="Center" ToolTip="Browse for file"/>
            </Grid>
        </DataTemplate>
        
        <!-- 3. String/Text Template (Uses a TextBox) -->
        <DataTemplate x:Key="StringTemplate">
            <Grid Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="NameColumn"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ValueColumn"/>
                    <!-- Button gets its own separate column next to the TextBox -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" MinWidth="120" VerticalAlignment="Center" Margin="0,0,15,0" />
                <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="180"/>
                <!--<Button Content="…" Command="{Binding BrowseFileCommand}"  Width="30" Margin="5,0,0,0" VerticalAlignment="Center" ToolTip="Browse for file"/>-->
            </Grid>
        </DataTemplate>

        <!-- 4. Wire everything up in the Template Selector -->
        <local1:SettingTemplateSelector x:Key="MySettingSelector"
            FolderTemplate="{StaticResource FolderTemplate}" 
            BooleanTemplate="{StaticResource BooleanTemplate}" 
            FilePathTemplate="{StaticResource FilePathTemplate}"
            StringTemplate="{StaticResource StringTemplate}"/>

        <!-- Add the FolderIconConverter instance here -->
        <local1:FolderIconConverter x:Key="FolderIconConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE: Navigation TreeView -->
        <!-- It only uses a single FolderTemplate now because it's just pure structural text labels -->
        <TreeView x:Name="SettingsTree" Grid.Column="0"
              ItemsSource="{Binding ElementName=SettingsWindow, Path=RootTree}" SelectedItemChanged="SettingsTree_SelectedItemChanged">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <!-- Dynamic icon swap: folder if it has kids, gear if it is a terminal setting -->
                        <TextBlock Text="{Binding Children.Count, Converter={StaticResource FolderIconConverter}}" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding Name}"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="LightGray"/>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="10,0,0,0">
            <Border Padding="15" BorderBrush="LightGray" BorderThickness="1" CornerRadius="3">
                <StackPanel Grid.IsSharedSizeScope="True">
                    <!-- Title Header showing current selected folder name -->
                    <TextBlock Text="{Binding ElementName=SettingsWindow, Path=ActiveHeaderName}" 
                           FontSize="18" FontWeight="Bold" Margin="0,0,0,15" />

                    <!-- Displays all settings belonging to the selected tree category together -->
                    <ItemsControl ItemsSource="{Binding ElementName=SettingsWindow, Path=ActiveSettingsSource}"
                              ItemTemplateSelector="{StaticResource MySettingSelector}">
                        
                        <!-- This injects a 10px bottom margin underneath every generated setting item -->
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,0,10"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </ScrollViewer>



        <!-- 
            We point the ItemTemplateSelector to our custom selector.
            The HierarchicalDataTemplate structure handles mapping the children.
        -->
        <!--<TreeView x:Name="SettingsTree" ItemsSource="{Binding ElementName=SettingsWindow, Path=RootTree}">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}" 
                                          ItemTemplateSelector="{StaticResource MySettingSelector}">
                    --><!-- This content presenter applies the selector to the root nodes too --><!--
                    <ContentPresenter Content="{Binding}" 
                                      ContentTemplateSelector="{StaticResource MySettingSelector}"/>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>-->
    </Grid>
</Window>
